pub module pzcorebus_bundled_dummy_slave::<
  PKG    : pzcorebus_proto_pkg,
  N_MREQ : u32                ,
  N_SRESP: u32                ,
> #(
  param SCMD_ACCEPT : lbool = true,
  param SDATA_ACCEPT: lbool = true,
)(
  slave_if: modport pzcorebus_bundled_if::<PKG, N_MREQ, N_SRESP>::slave,
) {
  always_comb {
    for i in 0..N_MREQ {
      slave_if.scmd_accept[i]  = SCMD_ACCEPT;
      slave_if.sdata_accept[i] = SDATA_ACCEPT;
    }

    for i in 0..N_SRESP {
      slave_if.sresp_valid[i]  = false;
      slave_if.sresp[i]        = 0 as PKG::pzcorebus_sresp;
      slave_if.sid[i]          = 0 as PKG::pzcorebus_sid;
      slave_if.serror[i]       = false;
      slave_if.sdata[i]        = 0 as PKG::pzcorebus_sdata;
      slave_if.sinfo[i]        = 0 as PKG::pzcorebus_sinfo;
      slave_if.sresp_uniten[i] = 0 as PKG::pzcorebus_sresp_uniten;
      slave_if.sresp_last[i]   = 0 as PKG::pzcorebus_sresp_last;
    }
  }
}
