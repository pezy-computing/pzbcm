pub module pzcorebus_demux::<PKG: pzcorebus_proto_pkg> #(
  param MASTERS     : u32           = 2                               ,
  param KIND        : selector_kind = selector_kind::ONEHOT           ,
  param SELECT_WIDTH: u32           = calc_select_width(MASTERS, KIND),
)(
  i_mcmd_select : input   logic<SELECT_WIDTH>                 ,
  i_mdata_select: input   logic<SELECT_WIDTH>                 ,
  i_sresp_select: input   logic<SELECT_WIDTH>                 ,
  slave_if      : modport pzcorebus_if::<PKG>::slave          ,
  master_if     : modport pzcorebus_if::<PKG>::master[MASTERS],
) {
  import $std::selector_pkg::*;
  import pzcorebus_common_pkg::is_mem_profile;

  var s_scmd_accept : logic                               ;
  var s_mcmd_valid  : logic                               ;
  var s_mcmd        : PKG::pzcorebus_packed_mcmd          ;
  var s_sdata_accept: logic                               ;
  var s_mdata_valid : logic                               ;
  var s_mdata       : PKG::pzcorebus_packed_mdata         ;
  var s_mresp_accept: logic                               ;
  var s_sresp_valid : logic                               ;
  var s_sresp       : PKG::pzcorebus_packed_sresp         ;
  var m_scmd_accept : logic                      <MASTERS>;
  var m_mcmd_valid  : logic                      <MASTERS>;
  var m_mcmd        : PKG::pzcorebus_packed_mcmd <MASTERS>;
  var m_sdata_accept: logic                      <MASTERS>;
  var m_mdata_valid : logic                      <MASTERS>;
  var m_mdata       : PKG::pzcorebus_packed_mdata<MASTERS>;
  var m_mresp_accept: logic                      <MASTERS>;
  var m_sresp_valid : logic                      <MASTERS>;
  var m_sresp       : PKG::pzcorebus_packed_sresp<MASTERS>;

  always_comb {
    slave_if.scmd_accept = s_scmd_accept;
    s_mcmd_valid         = slave_if.mcmd_valid;
    s_mcmd               = slave_if.get_packed_mcmd();

    slave_if.sdata_accept = s_sdata_accept;
    s_mdata_valid         = slave_if.mdata_valid;
    s_mdata               = slave_if.get_packed_mdata();
  }

  always_comb {
    s_mresp_accept       = slave_if.mresp_accept;
    slave_if.sresp_valid = s_sresp_valid;
    slave_if.put_packed_sresp(s_sresp);
  }

  always_comb {
    s_scmd_accept = $std::select::<KIND, MASTERS, lbool>(i_mcmd_select, m_scmd_accept);
    m_mcmd_valid  = $std::dispatch::<KIND, MASTERS, lbool>(i_mcmd_select, s_mcmd_valid, false);
  }

  if is_mem_profile(PKG::BUS_CONFIG) :g_mdata {
    always_comb {
      s_sdata_accept = $std::select::<KIND, MASTERS, lbool>(i_mdata_select, m_sdata_accept);
      m_mdata_valid  = $std::dispatch::<KIND, MASTERS, lbool>(i_mdata_select, s_mdata_valid, false);
    }
  } else {
    always_comb {
      s_scmd_accept = '0;
      m_mdata_valid = '0;
    }
  }

  always_comb {
    m_mresp_accept = $std::dispatch::<KIND, MASTERS, lbool>(i_sresp_select, s_mresp_accept, false);
    s_sresp_valid  = $std::select::<KIND, MASTERS, lbool>(i_sresp_select, m_sresp_valid);
    s_sresp        = $std::select::<KIND, MASTERS, PKG::pzcorebus_packed_sresp>(i_sresp_select, m_sresp);
  }

  for i in 0..MASTERS :g_master {
    always_comb {
      m_scmd_accept[i]        = master_if[i].scmd_accept;
      master_if[i].mcmd_valid = m_mcmd_valid[i];
      master_if[i].put_packed_mcmd(s_mcmd);

      m_sdata_accept[i]        = master_if[i].sdata_accept;
      master_if[i].mdata_valid = m_mdata_valid[i];
      master_if[i].put_packed_mdata(s_mdata);
    }

    always_comb {
      master_if[i].mresp_accept = m_mresp_accept[i];
      m_sresp_valid[i]          = master_if[i].sresp_valid;
      m_sresp[i]                = master_if[i].get_packed_sresp();
    }
  }
}
