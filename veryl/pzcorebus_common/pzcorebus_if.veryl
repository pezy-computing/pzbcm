pub interface pzcorebus_mreq_if::<PKG: pzcorebus_proto_pkg> {
  const MCMD_INFO : pzcorebus_common_pkg::pzcorebus_mcmd_info  = PKG::BUS_CONFIG.mcmd_info;
  const MDATA_INFO: pzcorebus_common_pkg::pzcorebus_mdata_info = PKG::BUS_CONFIG.mdata_info;

  var scmd_accept : logic                      ;
  var mcmd_valid  : logic                      ;
  var mcmd        : PKG::pzcorebus_mcmd        ;
  var mid         : PKG::pzcorebus_mid         ;
  var maddr       : PKG::pzcorebus_maddr       ;
  var mlength     : PKG::pzcorebus_mlength     ;
  var mparam      : PKG::pzcorebus_mparam      ;
  var minfo       : PKG::pzcorebus_minfo       ;
  var sdata_accept: logic                      ;
  var mdata_valid : logic                      ;
  var mdata       : PKG::pzcorebus_mdata       ;
  var mdata_byteen: PKG::pzcorebus_mdata_byteen;
  var mdata_last  : PKG::pzcorebus_mdata_last  ;

//--------------------------------------------------------------
//  API
//--------------------------------------------------------------
  function get_mcmd() -> PKG::pzcorebus_bundled_mcmd {
    var bundled_mcmd: PKG::pzcorebus_bundled_mcmd;
    bundled_mcmd.mcmd    = mcmd;
    bundled_mcmd.mid     = mid;
    bundled_mcmd.maddr   = maddr;
    bundled_mcmd.mlength = mlength;
    bundled_mcmd.mparam  = mparam;
    bundled_mcmd.minfo   = minfo;
    if PKG::IS_CSR {
      bundled_mcmd.mdata        = mdata;
      bundled_mcmd.mdata_byteen = mdata_byteen;
    } else {
      bundled_mcmd.mdata        = '0;
      bundled_mcmd.mdata_byteen = '0;
    }

    return bundled_mcmd;
  }

  function put_mcmd(bundled_mcmd: input PKG::pzcorebus_bundled_mcmd) {
    mcmd    = bundled_mcmd.mcmd;
    mid     = bundled_mcmd.mid;
    maddr   = bundled_mcmd.maddr;
    mlength = bundled_mcmd.mlength;
    mparam  = bundled_mcmd.mparam;
    minfo   = bundled_mcmd.minfo;
    if PKG::IS_CSR {
      mdata        = bundled_mcmd.mdata;
      mdata_byteen = bundled_mcmd.mdata_byteen;
    }
  }

  function get_mdata() -> PKG::pzcorebus_bundled_mdata {
    var bundled_mdata: PKG::pzcorebus_bundled_mdata;

    if PKG::IS_MEM {
      bundled_mdata.mdata        = mdata;
      bundled_mdata.mdata_byteen = mdata_byteen;
      bundled_mdata.mdata_last   = mdata_last;
    } else {
      bundled_mdata.mdata        = '0;
      bundled_mdata.mdata_byteen = '0;
      bundled_mdata.mdata_last   = '0;
    }

    return bundled_mdata;
  }

  function put_mdata(bundled_mdata: input PKG::pzcorebus_bundled_mdata) {
    if PKG::IS_MEM {
      mdata        = bundled_mdata.mdata;
      mdata_byteen = bundled_mdata.mdata_byteen;
      mdata_last   = bundled_mdata.mdata_last;
    }
  }

  function get_packed_mcmd() -> PKG::pzcorebus_packed_mcmd {
    var packer: PKG::pzcorebus_packed_mcmd;

    packer = '0;
    if MCMD_INFO.mcmd.width >: 0 {
      packer |= (mcmd << MCMD_INFO.mcmd.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if MCMD_INFO.mid.width >: 0 {
      packer |= (mid << MCMD_INFO.mid.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if MCMD_INFO.maddr.width >: 0 {
      packer |= (maddr << MCMD_INFO.maddr.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if MCMD_INFO.mlength.width >: 0 {
      packer |= (mlength << MCMD_INFO.mlength.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if MCMD_INFO.mparam.width >: 0 {
      packer |= (mparam << MCMD_INFO.mparam.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if MCMD_INFO.minfo.width >: 0 {
      packer |= (minfo << MCMD_INFO.minfo.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if PKG::IS_CSR && MCMD_INFO.mdata.width >: 0 {
      packer |= (mdata << MCMD_INFO.mdata.pos) as PKG::pzcorebus_packed_mcmd;
    }
    if PKG::IS_CSR && MCMD_INFO.mdata_byteen.width >: 0 {
      packer |= (mdata_byteen << MCMD_INFO.mdata_byteen.pos) as PKG::pzcorebus_packed_mcmd;
    }

    return packer;
  }

  function put_packed_mcmd(packed_mcmd: input PKG::pzcorebus_packed_mcmd) {
    if MCMD_INFO.mcmd.width >: 0 {
      mcmd = (packed_mcmd >> MCMD_INFO.mcmd.pos) as PKG::pzcorebus_mcmd;
    }
    if MCMD_INFO.mid.width >: 0 {
      mid = (packed_mcmd >> MCMD_INFO.mid.pos) as PKG::pzcorebus_mid;
    }
    if MCMD_INFO.maddr.width >: 0 {
      maddr = (packed_mcmd >> MCMD_INFO.maddr.pos) as PKG::pzcorebus_maddr;
    }
    if MCMD_INFO.mlength.width >: 0 {
      mlength = (packed_mcmd >> MCMD_INFO.mlength.pos) as PKG::pzcorebus_mlength;
    }
    if MCMD_INFO.mparam.width >: 0 {
      mparam = (packed_mcmd >> MCMD_INFO.mparam.pos) as PKG::pzcorebus_mparam;
    }
    if MCMD_INFO.minfo.width >: 0 {
      minfo = (packed_mcmd >> MCMD_INFO.minfo.pos) as PKG::pzcorebus_minfo;
    }
    if PKG::IS_CSR && MCMD_INFO.mdata.width >: 0 {
      mdata = (packed_mcmd >> MCMD_INFO.mdata.pos) as PKG::pzcorebus_mdata;
    }
    if PKG::IS_CSR && MCMD_INFO.mdata_byteen.width >: 0 {
      mdata_byteen = (packed_mcmd >> MCMD_INFO.mdata_byteen.pos) as PKG::pzcorebus_mdata_byteen;
    }
  }

  function get_packed_mdata() -> PKG::pzcorebus_packed_mdata {
    var packer: PKG::pzcorebus_packed_mdata;

    packer = '0;
    if PKG::IS_MEM {
      if MDATA_INFO.mdata.width >: 0 {
        packer |= (mdata << MDATA_INFO.mdata.pos) as PKG::pzcorebus_packed_mdata;
      }
      if MDATA_INFO.mdata_byteen.width >: 0 {
        packer |= (mdata_byteen << MDATA_INFO.mdata_byteen.pos) as PKG::pzcorebus_packed_mdata;
      }
      if MDATA_INFO.mdata_last.width >: 0 {
        packer |= (mdata_last << MDATA_INFO.mdata_last.pos) as PKG::pzcorebus_packed_mdata;
      }
    }

    return packer;
  }

  function put_packed_mdata(packed_mdata: input PKG::pzcorebus_packed_mdata) {
    if PKG::IS_MEM {
      if MDATA_INFO.mdata.width >: 0 {
        mdata = (packed_mdata >> MDATA_INFO.mdata.pos) as PKG::pzcorebus_mdata;
      }
      if MDATA_INFO.mdata_byteen.width >: 0 {
        mdata_byteen = (packed_mdata >> MDATA_INFO.mdata_byteen.pos) as PKG::pzcorebus_mdata_byteen;
      }
      if MDATA_INFO.mdata_last.width >: 0 {
        mdata_last = (packed_mdata >> MDATA_INFO.mdata_last.pos) as PKG::pzcorebus_mdata_last;
      }
    }
  }

  function mcmd_kind() -> pzcorebus_common_pkg::pzcorebus_mcmd_kind {
    return pzcorebus_utils_pkg::<PKG>::mcmd_kind(mcmd);
  }

  function is_mcmd_posted() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_posted(mcmd);
  }

  function is_mcmd_non_posted() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_non_posted(mcmd);
  }

  function is_mcmd_no_data() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_no_data(mcmd);
  }

  function is_mcmd_with_data() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_with_data(mcmd);
  }

  function is_mcmd_read() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_read(mcmd);
  }

  function is_mcmd_broadcast() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_broadcast(mcmd);
  }

  function is_mcmd_atomic() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_atomic(mcmd);
  }

  function is_mcmd_message() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_message(mcmd);
  }

  function is_mcmd_with_response_data() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_mcmd_with_response_data(mcmd);
  }

  function mcmd_ack() -> logic {
    return scmd_accept && mcmd_valid;
  }

  function mcmd_posted_ack() -> logic {
    return mcmd_ack() && is_mcmd_posted();
  }

  function mcmd_non_posted_ack() -> logic {
    return mcmd_ack() && is_mcmd_non_posted();
  }

  function mcmd_no_data_ack() -> logic {
    return mcmd_ack() && is_mcmd_no_data();
  }

  function mcmd_with_data_ack() -> logic {
    return mcmd_ack() && is_mcmd_with_data();
  }

  function mcmd_posted_valid() -> logic {
    return mcmd_valid && is_mcmd_posted();
  }

  function mcmd_non_posted_valid() -> logic {
    return mcmd_valid && is_mcmd_non_posted();
  }

  function mcmd_no_data_valid() -> logic {
    return mcmd_valid && is_mcmd_no_data();
  }

  function mcmd_with_data_valid() -> logic {
    return mcmd_valid && is_mcmd_with_data();
  }

  function mdata_ack() -> logic {
    if PKG::IS_MEM {
      return sdata_accept && mdata_valid;
    } else {
      return '0;
    }
  }

  function mdata_last_ack() -> logic {
    return mdata_ack() && mdata_last;
  }

  function get_mlength_unpacked() -> PKG::pzcorebus_mlength_unpacked {
    return pzcorebus_utils_pkg::<PKG>::get_mlength_unpacked(mcmd, mlength);
  }

  function get_mlength_aligned() -> PKG::pzcorebus_mlength_unpacked {
    return pzcorebus_utils_pkg::<PKG>::get_mlength_aligned(mcmd, maddr, mlength);
  }

  function get_mburst_length() -> PKG::pzcorebus_mburst_length {
    return pzcorebus_utils_pkg::<PKG>::get_mburst_length(mcmd, maddr, mlength);
  }

//--------------------------------------------------------------
//  Modport
//--------------------------------------------------------------
  modport master_mcmd {
    scmd_accept               : input ,
    mcmd_valid                : output,
    mcmd                      : output,
    mid                       : output,
    maddr                     : output,
    mlength                   : output,
    mparam                    : output,
    minfo                     : output,
    put_mcmd                  : import,
    put_packed_mcmd           : import,
    mcmd_kind                 : import,
    is_mcmd_posted            : import,
    is_mcmd_non_posted        : import,
    is_mcmd_no_data           : import,
    is_mcmd_with_data         : import,
    is_mcmd_read              : import,
    is_mcmd_broadcast         : import,
    is_mcmd_atomic            : import,
    is_mcmd_message           : import,
    is_mcmd_with_response_data: import,
    mcmd_ack                  : import,
    mcmd_posted_ack           : import,
    mcmd_non_posted_ack       : import,
    mcmd_no_data_ack          : import,
    mcmd_with_data_ack        : import,
    mcmd_posted_valid         : import,
    mcmd_non_posted_valid     : import,
    mcmd_no_data_valid        : import,
    mcmd_with_data_valid      : import,
    get_mlength_unpacked      : import,
    get_mlength_aligned       : import,
    get_mburst_length         : import,
  }

  modport master_mdata {
    sdata_accept     : input ,
    mdata_valid      : output,
    mdata            : output,
    mdata_byteen     : output,
    mdata_last       : output,
    put_mdata        : import,
    put_packed_mdata : import,
    mdata_ack        : import,
    mdata_last_ack   : import,
  }

  modport master_mreq {
    ..same(master_mcmd, master_mdata)
  }

  modport slave_mcmd {
    get_mcmd                  : import,
    get_packed_mcmd           : import,
    mcmd_kind                 : import,
    is_mcmd_posted            : import,
    is_mcmd_non_posted        : import,
    is_mcmd_no_data           : import,
    is_mcmd_with_data         : import,
    is_mcmd_read              : import,
    is_mcmd_broadcast         : import,
    is_mcmd_atomic            : import,
    is_mcmd_message           : import,
    is_mcmd_with_response_data: import,
    mcmd_ack                  : import,
    mcmd_posted_ack           : import,
    mcmd_non_posted_ack       : import,
    mcmd_no_data_ack          : import,
    mcmd_with_data_ack        : import,
    mcmd_posted_valid         : import,
    mcmd_non_posted_valid     : import,
    mcmd_no_data_valid        : import,
    mcmd_with_data_valid      : import,
    get_mlength_unpacked      : import,
    get_mlength_aligned       : import,
    get_mburst_length         : import,
    ..converse(master_mcmd)
  }

  modport slave_mdata {
    get_mdata         : import,
    get_packed_mdata  : import,
    mdata_ack         : import,
    mdata_last_ack    : import,
    ..converse(master_mdata)
  }

  modport slave_mreq {
    ..same(slave_mcmd, slave_mdata)
  }
}

pub interface pzcorebus_sresp_if::<PKG: pzcorebus_proto_pkg> {
  const SRESP_INFO: pzcorebus_common_pkg::pzcorebus_sresp_info = PKG::BUS_CONFIG.sresp_info;

  var mresp_accept: logic                      ;
  var sresp_valid : logic                      ;
  var sresp       : PKG::pzcorebus_sresp       ;
  var sid         : PKG::pzcorebus_sid         ;
  var serror      : PKG::pzcorebus_serror      ;
  var sdata       : PKG::pzcorebus_sdata       ;
  var sinfo       : PKG::pzcorebus_sinfo       ;
  var sresp_uniten: PKG::pzcorebus_sresp_uniten;
  var sresp_last  : PKG::pzcorebus_sresp_last  ;

//--------------------------------------------------------------
//  API
//--------------------------------------------------------------
  function get_sresp() -> PKG::pzcorebus_bundled_sresp {
    var bundled_sresp: PKG::pzcorebus_bundled_sresp;

    bundled_sresp.sresp        = sresp;
    bundled_sresp.sid          = sid;
    bundled_sresp.serror       = serror;
    bundled_sresp.sdata        = sdata;
    bundled_sresp.sinfo        = sinfo;
    bundled_sresp.sresp_uniten = sresp_uniten;
    bundled_sresp.sresp_last   = sresp_last;

    return bundled_sresp;
  }

  function get_packed_sresp() -> PKG::pzcorebus_packed_sresp {
    var packer: PKG::pzcorebus_packed_sresp;

    packer = '0;
    if SRESP_INFO.sresp.width >: 0 {
      packer |= (sresp << SRESP_INFO.sresp.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.sid.width >: 0 {
      packer |= (sid << SRESP_INFO.sid.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.serror.width >: 0 {
      packer |= (serror << SRESP_INFO.serror.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.sdata.width >: 0 {
      packer |= (sdata << SRESP_INFO.sdata.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.sinfo.width >: 0 {
      packer |= (sinfo << SRESP_INFO.sinfo.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.sresp_uniten.width >: 0 {
      packer |= (sresp_uniten << SRESP_INFO.sresp_uniten.pos) as PKG::pzcorebus_packed_sresp;
    }
    if SRESP_INFO.sresp_last.width >: 0 {
      packer |= (sresp_last << SRESP_INFO.sresp_last.pos) as PKG::pzcorebus_packed_sresp;
    }

    return packer;
  }

  function put_sresp(bundled_sresp: input PKG::pzcorebus_bundled_sresp) {
    sresp        = bundled_sresp.sresp;
    sid          = bundled_sresp.sid;
    serror       = bundled_sresp.serror;
    sdata        = bundled_sresp.sdata;
    sinfo        = bundled_sresp.sinfo;
    sresp_uniten = bundled_sresp.sresp_uniten;
    sresp_last   = bundled_sresp.sresp_last;
  }

  function put_packed_sresp(packed_sresp: input PKG::pzcorebus_packed_sresp) {
    if SRESP_INFO.sresp.width >: 0 {
      sresp = (packed_sresp >> SRESP_INFO.sresp.pos) as PKG::pzcorebus_sresp;
    }
    if SRESP_INFO.sid.width >: 0 {
      sid = (packed_sresp >> SRESP_INFO.sid.pos) as PKG::pzcorebus_sid;
    }
    if SRESP_INFO.serror.width >: 0 {
      serror = (packed_sresp >> SRESP_INFO.serror.pos) as PKG::pzcorebus_serror;
    }
    if SRESP_INFO.sdata.width >: 0 {
      sdata = (packed_sresp >> SRESP_INFO.sdata.pos) as PKG::pzcorebus_sdata;
    }
    if SRESP_INFO.sinfo.width >: 0 {
      sinfo = (packed_sresp >> SRESP_INFO.sinfo.pos) as PKG::pzcorebus_sinfo;
    }
    if SRESP_INFO.sresp_uniten.width >: 0 {
      sresp_uniten = (packed_sresp >> SRESP_INFO.sresp_uniten.pos) as PKG::pzcorebus_sresp_uniten;
    }
    if SRESP_INFO.sresp_last.width >: 0 {
      sresp_last = (packed_sresp >> SRESP_INFO.sresp_last.pos) as PKG::pzcorebus_sresp_last;
    }
  }

  function is_sresp_no_data() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_sresp_no_data(sresp);
  }

  function is_sresp_with_data() -> logic {
    return pzcorebus_utils_pkg::<PKG>::is_sresp_with_data(sresp);
  }

  function sresp_ack() -> logic {
    return mresp_accept && sresp_valid;
  }

  function sresp_no_data_ack() -> logic {
    return sresp_ack() && is_sresp_no_data();
  }

  function sresp_with_data_ack() -> logic {
    return sresp_ack() && is_sresp_with_data();
  }

  function sresp_last_ack() -> logic {
    if PKG::IS_MEM {
      return sresp_ack() && sresp_last[0];
    } else {
      return sresp_ack();
    }
  }

  function sresp_sublast_ack() -> logic {
    const FLAG_POS: u16 = $bits(PKG::pzcorebus_sresp_last) - 1;
    if PKG::IS_MEM {
      return sresp_ack() && sresp_last[FLAG_POS];
    } else {
      return sresp_ack();
    }
  }

//--------------------------------------------------------------
//  Modport
//--------------------------------------------------------------
  modport master_sresp {
    mresp_accept       : output,
    sresp_valid        : input ,
    sresp              : input ,
    sid                : input ,
    serror             : input ,
    sdata              : input ,
    sinfo              : input ,
    sresp_uniten       : input ,
    sresp_last         : input ,
    get_sresp          : import,
    get_packed_sresp   : import,
    is_sresp_no_data   : import,
    is_sresp_with_data : import,
    sresp_ack          : import,
    sresp_no_data_ack  : import,
    sresp_with_data_ack: import,
    sresp_last_ack     : import,
    sresp_sublast_ack  : import,
  }

  modport slave_sresp {
    put_sresp          : import,
    put_packed_sresp   : import,
    is_sresp_no_data   : import,
    is_sresp_with_data : import,
    sresp_ack          : import,
    sresp_no_data_ack  : import,
    sresp_with_data_ack: import,
    sresp_last_ack     : import,
    sresp_sublast_ack  : import,
    ..converse(master_sresp)
  }
}

pub interface pzcorebus_if::<PKG: pzcorebus_proto_pkg> {
  mixin pzcorebus_mreq_if::<PKG>;
  mixin pzcorebus_sresp_if::<PKG>;

//--------------------------------------------------------------
//  API
//--------------------------------------------------------------
  function get_sresp_length() -> PKG::pzcorebus_mlength_unpacked {
    if is_mcmd_message() {
      return PKG::BUS_CONFIG.data_size as PKG::pzcorebus_mlength_unpacked;
    } else {
      return get_mlength_unpacked();
    }
  }

  function get_sresp_offset() -> PKG::pzcorebus_sresp_offset {
    const OFFSET_LSB  : u32 = pzcorebus_common_pkg::get_sresp_offset_lsb(PKG::BUS_CONFIG);
    const OFFSET_WIDTH: u32 = $bits(PKG::pzcorebus_sresp_offset);

    if PKG::IS_MEM_H && is_mcmd_read() {
      return maddr[OFFSET_LSB+:OFFSET_WIDTH];
    } else {
      return 0 as PKG::pzcorebus_sresp_offset;
    }
  }

//--------------------------------------------------------------
//  Modport
//--------------------------------------------------------------
  modport master {
    ..same(master_mreq, master_sresp)
  }

  modport slave {
    ..same(slave_mreq, slave_sresp)
  }

  modport monitor {
    get_mcmd                  : import,
    get_mdata                 : import,
    get_sresp                 : import,
    get_packed_mcmd           : import,
    get_packed_mdata          : import,
    get_packed_sresp          : import,
    mcmd_kind                 : import,
    is_mcmd_posted            : import,
    is_mcmd_non_posted        : import,
    is_mcmd_no_data           : import,
    is_mcmd_with_data         : import,
    is_mcmd_read              : import,
    is_mcmd_broadcast         : import,
    is_mcmd_atomic            : import,
    is_mcmd_message           : import,
    is_mcmd_with_response_data: import,
    mcmd_ack                  : import,
    mcmd_posted_ack           : import,
    mcmd_non_posted_ack       : import,
    mcmd_no_data_ack          : import,
    mcmd_with_data_ack        : import,
    mcmd_posted_valid         : import,
    mcmd_non_posted_valid     : import,
    mcmd_no_data_valid        : import,
    mcmd_with_data_valid      : import,
    mdata_ack                 : import,
    mdata_last_ack            : import,
    is_sresp_no_data          : import,
    is_sresp_with_data        : import,
    sresp_ack                 : import,
    sresp_no_data_ack         : import,
    sresp_with_data_ack       : import,
    sresp_last_ack            : import,
    sresp_sublast_ack         : import,
    get_mlength_unpacked      : import,
    get_mlength_aligned       : import,
    get_mburst_length         : import,
    get_sresp_length          : import,
    get_sresp_offset          : import,
    ..input
  }
}
